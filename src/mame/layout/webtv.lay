<?xml version="1.0"?>
<mamelayout version="2">
	<element name="power_led" defstate="0">
		<rect state="1"><color red="0.0" green="0.75" blue="0.0" /></rect>
		<rect state="0"><color red="0.0" green="0.20" blue="0.0" /></rect>
	</element>
	<element name="connect_led" defstate="0">
		<rect state="1"><color red="0.75" green="0.65" blue="0.0" /></rect>
		<rect state="0"><color red="0.20" green="0.15" blue="0.0" /></rect>
	</element>
	<element name="message_led" defstate="0">
		<rect state="3"><color red="0.00" green="0.0" blue="0.75" /></rect>
		<rect state="2"><color red="0.00" green="0.0" blue="0.20" /></rect>

		<rect state="1"><color red="0.75" green="0.0" blue="0.0" /></rect>
		<rect state="0"><color red="0.20" green="0.0" blue="0.0" /></rect>
	</element>

	<element name="spacer">
		<rect><color red="0.0" green="0.0" blue="0.0" /></rect>
	</element>

	<element name="text_power">
		<text string="POWER"><color red="0.8" green="0.8" blue="0.8" /></text>
	</element>
	<element name="text_connect">
		<text string="CONNECTED"><color red="0.8" green="0.8" blue="0.8" /></text>
	</element>
	<element name="text_message">
		<text string="MESSAGE"><color red="0.8" green="0.8" blue="0.8" /></text>
	</element>

	<element name="power_button" defstate="0">
		<rect><bounds x="0" y="0" width="30" height="20" /><color red="0.45" green="0.45" blue="0.45" /></rect>
		<rect state="0"><bounds x="1" y="1" width="28" height="18" /><color red="0.18" green="0.18" blue="0.18" /></rect>
		<rect state="1"><bounds x="1" y="1" width="28" height="18" /><color red="0.38" green="0.38" blue="0.38" /></rect>
		<disk><bounds x="9" y="4" width="12" height="12" /><color red="0.85" green="0.85" blue="0.85" /></disk>
		<disk state="0"><bounds x="10.75" y="5.75" width="8.5" height="8.5" /><color red="0.18" green="0.18" blue="0.18" /></disk>
		<disk state="1"><bounds x="10.75" y="5.75" width="8.5" height="8.5" /><color red="0.38" green="0.38" blue="0.38" /></disk>
		<rect state="0"><bounds x="12.5" y="3" width="5" height="5" /><color red="0.18" green="0.18" blue="0.18" /></rect>
		<rect state="1"><bounds x="12.5" y="3" width="5" height="5" /><color red="0.38" green="0.38" blue="0.38" /></rect>
		<rect><bounds x="14.1" y="3" width="1.8" height="7" /><color red="0.85" green="0.85" blue="0.85" /></rect>
	</element>
	<element name="power_button_pressed" defstate="0">
		<rect state="1"><bounds x="0" y="0" width="30" height="20" /><color red="0.45" green="0.45" blue="0.45" /></rect>
		<rect state="1"><bounds x="1" y="1" width="28" height="18" /><color red="0.38" green="0.38" blue="0.38" /></rect>
		<disk state="1"><bounds x="9" y="4" width="12" height="12" /><color red="0.85" green="0.85" blue="0.85" /></disk>
		<disk state="1"><bounds x="10.75" y="5.75" width="8.5" height="8.5" /><color red="0.38" green="0.38" blue="0.38" /></disk>
		<rect state="1"><bounds x="12.5" y="3" width="5" height="5" /><color red="0.38" green="0.38" blue="0.38" /></rect>
		<rect state="1"><bounds x="14.1" y="3" width="1.8" height="7" /><color red="0.85" green="0.85" blue="0.85" /></rect>
	</element>

	<group name="status_leds">
		<element ref="text_power"><bounds x="0" y="5.5" width="52" height="8" /></element>
		<element name="power_led" ref="power_led"><bounds x="14" y="15" width="24" height="9" /></element>

		<element ref="text_connect"><bounds x="52" y="5.5" width="52" height="8" /></element>
		<element name="connect_led" ref="connect_led"><bounds x="66" y="15" width="24" height="9" /></element>

		<element ref="text_message"><bounds x="104" y="5.5" width="52" height="8" /></element>
		<element name="message_led" ref="message_led"><bounds x="118" y="15" width="24" height="9" /></element>

		<element name="spacer" ref="spacer"><bounds x="0" y="25" width="156" height="2" /></element>
	</group>

	<group name="power_button">
		<bounds x="0" y="5" width="70" height="22" />
		<element ref="power_button"><bounds x="0" y="5" width="30" height="20" /></element>
		<!-- webtv2 -->
		<element ref="power_button_pressed" inputtag="solo:irkbdc:wtvir_kbd1" inputmask="0x0800"><bounds x="0" y="5" width="30" height="20" /></element>
		<!-- webtv1 -->
		<element ref="power_button_pressed" inputtag="spot:kbd:pc_keyboard_3" inputmask="0x0800"><bounds x="0" y="5" width="30" height="20" /></element>
		<!-- msntv2 -->
		<element ref="power_button_pressed" inputtag="pci:1f.0:lpcbus:slot0:pport:msntv2_fpanel:irkbd:pc_keyboard_6" inputmask="0x0001"><bounds x="0" y="5" width="30" height="20" /></element>
		<!-- there's another option with wtv1bfe pre-alpha builds that use F3. That case isn't handled here... -->
	</group>

	<view name="Default Layout" showpointers="no">
		<screen index="0">
			<bounds x="0" y="0" width="~scr0width~" height="~scr0height~" />
		</screen>

		<!--
			TODO: theme this more? maybe display a box based on the selected machine. Image of fonts instead of using the distorted UI font?

			Keeping the square status LEDs for now, gives us more screen.
		-->
		<collection name="Status LEDs" visible="yes">
			<group ref="status_leds">
				<bounds x="0" y="~scr0height~" width="156" height="22" />
			</group>
			<group ref="power_button">
				<bounds xc="~scr0width~" y="~scr0height~" width="70" height="22" />
			</group>
		</collection>
	</view>
</mamelayout>
